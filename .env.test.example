# =============================================================================
# Live Test Configuration
# =============================================================================
#
# Copy this file to .env.test and fill in your values.
# The .env.test file is automatically loaded by the live test suite.
#
# Configuration Priority:
#   1. Command-line arguments (--api-key, --swagger-url, etc.)
#   2. Environment variables (TOGETHER_API_KEY, SWAGGER_URL, etc.)
#   3. .env.test file (this file, after you rename it)
#
# =============================================================================

# -----------------------------------------------------------------------------
# Required Configuration
# -----------------------------------------------------------------------------

# Together AI API Key (required for all live tests)
# Get your key from: https://api.together.xyz/
TOGETHER_API_KEY=your_api_key_here

# Swagger/OpenAPI URL to test against (required)
# Examples:
#   - https://petstore.swagger.io/v2/swagger.json
#   - https://your-api.com/openapi.json
SWAGGER_URL=https://petstore.swagger.io/v2/swagger.json

# -----------------------------------------------------------------------------
# Optional Configuration
# -----------------------------------------------------------------------------

# Path to local Swagger/OpenAPI file (alternative to SWAGGER_URL)
# If set, this takes priority over SWAGGER_URL
# SWAGGER_FILE=/path/to/your/swagger.json

# Target host for generated tests (optional)
# If not set, will be auto-detected from Swagger spec
# TARGET_HOST=http://localhost:8000

# Custom output directory for generated tests (optional)
# If not set, uses a temporary directory
# TEST_OUTPUT_DIR=./test_output

# Keep generated output files after tests (for inspection)
# Set to "true" to keep files, or leave unset to clean up
# KEEP_TEST_OUTPUT=false

# -----------------------------------------------------------------------------
# Database Integration (Optional)
# -----------------------------------------------------------------------------

# MongoDB connection URI (for --db-type mongo tests)
# If not set, MongoDB-specific tests will be skipped
# MONGODB_URI=mongodb://localhost:27017/testdb

# PostgreSQL connection URI (for --db-type postgresql tests)
# If not set, PostgreSQL-specific tests will be skipped
# POSTGRESQL_URI=postgresql://user:password@localhost:5432/testdb

# -----------------------------------------------------------------------------
# Advanced Configuration
# -----------------------------------------------------------------------------

# Custom test timeout in seconds (default: 300)
# TEST_TIMEOUT=300

# Enable verbose test output
# VERBOSE_TESTS=true
