@dataclass
class RequestContext:
    """Captures full request details for error logging"""
    method: str
    url: str
    path: str
    headers: Dict[str, str] = field(default_factory=dict)
    body: Optional[Any] = None
    params: Optional[Dict[str, Any]] = None
    files: Optional[Dict[str, Any]] = None
    timestamp: str = field(default_factory=lambda: datetime.now().isoformat())

    def to_log_string(self) -> str:
        """Format request details for logging"""
        lines = [
            f"  Method: {self.method}",
            f"  URL: {self.url}",
            f"  Path: {self.path}",
            f"  Timestamp: {self.timestamp}",
        ]
        if self.headers:
            # Mask sensitive headers
            safe_headers = {k: ('***' if k.lower() in ['authorization', 'x-api-key', 'cookie'] else v)
                          for k, v in self.headers.items()}
            lines.append(f"  Headers: {json.dumps(safe_headers, indent=4, default=str)}")
        if self.params:
            lines.append(f"  Query Params: {json.dumps(self.params, indent=4, default=str)}")
        if self.body is not None:
            body_str = json.dumps(self.body, indent=4, default=str) if isinstance(self.body, (dict, list)) else str(self.body)
            # Truncate very long bodies
            if len(body_str) > 2000:
                body_str = body_str[:2000] + "\n    ... [truncated]"
            lines.append(f"  Request Body: {body_str}")
        if self.files:
            lines.append(f"  Files: {list(self.files.keys())}")
        return "\n".join(lines)


@dataclass
class ResponseContext:
    """Captures full response details for error logging"""
    status_code: int
    headers: Dict[str, str] = field(default_factory=dict)
    body: Optional[str] = None
    elapsed_ms: float = 0
    reason: str = ""

    def to_log_string(self) -> str:
        """Format response details for logging"""
        lines = [
            f"  Status Code: {self.status_code}",
            f"  Reason: {self.reason}",
            f"  Response Time: {self.elapsed_ms:.2f}ms",
        ]
        if self.headers:
            lines.append(f"  Response Headers: {json.dumps(dict(self.headers), indent=4, default=str)}")
        if self.body:
            body_str = self.body
            # Truncate very long bodies
            if len(body_str) > 2000:
                body_str = body_str[:2000] + "\n    ... [truncated]"
            lines.append(f"  Response Body: {body_str}")
        return "\n".join(lines)


@dataclass
class ErrorContext:
    """Full context for error logging"""
    error_type: str  # "validation_failed", "connection_error", "timeout", "exception"
    message: str
    request: Optional[RequestContext] = None
    response: Optional[ResponseContext] = None
    expected_status: Optional[List[int]] = None
    actual_status: Optional[int] = None
    exception: Optional[Exception] = None
    stack_trace: Optional[str] = None


def log_failure(error_ctx: ErrorContext):
    """
    Log a failure with full context for debugging.

    This is the main function to call when something goes wrong.
    It provides all the details needed to understand what happened.
    """
    separator = "=" * 80

    # Build the log message
    lines = [
        "",
        separator,
        f"REQUEST FAILURE: {error_ctx.error_type.upper()}",
        separator,
        f"Error: {error_ctx.message}",
    ]

    # Add expected vs actual status
    if error_ctx.expected_status is not None:
        lines.append(f"Expected Status Codes: {error_ctx.expected_status}")
    if error_ctx.actual_status is not None:
        lines.append(f"Actual Status Code: {error_ctx.actual_status}")
        # Explain status code 0
        if error_ctx.actual_status == 0:
            lines.append("  NOTE: Status code 0 means NO RESPONSE was received from the server.")
            lines.append("  Possible causes: connection refused, timeout, DNS failure, server not running")

    # Add request details
    if error_ctx.request:
        lines.append("")
        lines.append("REQUEST DETAILS:")
        lines.append(error_ctx.request.to_log_string())

    # Add response details
    if error_ctx.response:
        lines.append("")
        lines.append("RESPONSE DETAILS:")
        lines.append(error_ctx.response.to_log_string())

    # Add exception details
    if error_ctx.exception:
        lines.append("")
        lines.append(f"EXCEPTION TYPE: {type(error_ctx.exception).__name__}")
        lines.append(f"EXCEPTION MESSAGE: {str(error_ctx.exception)}")

    # Add stack trace
    if error_ctx.stack_trace:
        lines.append("")
        lines.append("STACK TRACE:")
        lines.append(error_ctx.stack_trace)

    lines.append(separator)
    lines.append("")

    # Log the full message
    logger.error("\n".join(lines))


def capture_exception_context() -> str:
    """Capture the current exception's stack trace"""
    return traceback.format_exc()


def create_request_context(method: str, path: str, url: str, **kwargs) -> RequestContext:
    """Create a RequestContext from request arguments"""
    return RequestContext(
        method=method.upper(),
        path=path,
        url=url,
        headers=kwargs.get('headers', {}),
        body=kwargs.get('json') or kwargs.get('data'),
        params=kwargs.get('params'),
        files=kwargs.get('files'),
    )


def create_response_context(response) -> ResponseContext:
    """Create a ResponseContext from a response object"""
    try:
        body = response.text[:5000] if response.text else None
    except Exception:
        body = "<unable to read response body>"

    try:
        elapsed_ms = response.elapsed.total_seconds() * 1000
    except Exception:
        elapsed_ms = 0

    try:
        headers = dict(response.headers)
    except Exception:
        headers = {}

    try:
        reason = response.reason or ""
    except Exception:
        reason = ""

    return ResponseContext(
        status_code=getattr(response, 'status_code', 0),
        headers=headers,
        body=body,
        elapsed_ms=elapsed_ms,
        reason=reason,
    )


@dataclass
class ResponseMetric:
    """Response metric data structure"""
    method: str
    endpoint: str
    response_time: float
    status_code: int
    response_size: int
    timestamp: datetime
    success: bool
    error_message: Optional[str] = None


class ResponseValidator:
    """Validates HTTP responses against expected criteria with enhanced error logging"""

    def __init__(self):
        # Default validation rules by HTTP method (fallback when no expected_status provided)
        self.validation_rules = {
            'GET': {
                'expected_status': [200, 202, 206],
                'max_response_time_ms': 2000,
                'required_headers': ['content-type'],
                'forbidden_headers': ['x-debug', 'x-error-detail']
            },
            'POST': {
                'expected_status': [200, 201, 202],
                'max_response_time_ms': 3000,
                'required_headers': ['content-type']
            },
            'PUT': {
                'expected_status': [200, 202, 204],
                'max_response_time_ms': 3000,
                'required_headers': ['content-type']
            },
            'PATCH': {
                'expected_status': [200, 202, 204],
                'max_response_time_ms': 3000,
                'required_headers': ['content-type']
            },
            'DELETE': {
                'expected_status': [200, 202, 204],
                'max_response_time_ms': 2000
            }
        }
        # Store current request context for error logging
        self._current_request_context: Optional[RequestContext] = None

    def set_request_context(self, request_ctx: RequestContext):
        """Set the current request context for detailed error logging"""
        self._current_request_context = request_ctx

    def clear_request_context(self):
        """Clear the current request context"""
        self._current_request_context = None

    def validate_response(self, response, method: str, endpoint: str,
                          expected_status: Optional[List[int]] = None,
                          request_context: Optional[RequestContext] = None) -> bool:
        """Validate HTTP response against expected criteria.

        Args:
            response: The HTTP response object
            method: HTTP method (GET, POST, etc.)
            endpoint: The API endpoint path
            expected_status: Optional list of valid status codes from OpenAPI spec.
                           If provided, overrides the default method-based rules.
                           This allows per-endpoint validation (e.g., POST that returns 422).
            request_context: Optional RequestContext for detailed error logging

        Returns:
            bool: True if response is valid, False otherwise
        """
        is_valid = True
        validation_errors = []
        method_upper = method.upper()
        rules = self.validation_rules.get(method_upper, {})

        # Use provided request context or fall back to stored one
        req_ctx = request_context or self._current_request_context

        # Use caller-provided expected_status if available (from OpenAPI spec),
        # otherwise fall back to method-based defaults
        if expected_status is not None:
            valid_status_codes = expected_status
        else:
            valid_status_codes = rules.get('expected_status', [200])

        # Validate status code
        if response.status_code not in valid_status_codes:
            validation_errors.append(f"Unexpected status code: got {response.status_code}, expected one of {valid_status_codes}")
            is_valid = False

        # Validate response time
        max_time = rules.get('max_response_time_ms', 5000)
        elapsed_ms = response.elapsed.total_seconds() * 1000
        if elapsed_ms > max_time:
            validation_errors.append(f"Slow response: {elapsed_ms:.2f}ms exceeds max {max_time}ms")
            # Note: slow response is a warning, not a failure
            logger.warning(f"Slow response {elapsed_ms:.2f}ms for {method_upper} {endpoint} (max: {max_time}ms)")

        # Check forbidden headers (security)
        forbidden_headers = rules.get('forbidden_headers', [])
        for header in forbidden_headers:
            if header.lower() in [h.lower() for h in response.headers.keys()]:
                validation_errors.append(f"Forbidden header '{header}' present in response")
                is_valid = False

        # Validate JSON response structure
        if response.status_code < 400 and 'application/json' in response.headers.get('content-type', ''):
            try:
                json_data = response.json()
                if not self._validate_json_structure(json_data, method_upper, endpoint):
                    validation_errors.append("Invalid JSON structure in response")
                    is_valid = False
            except json.JSONDecodeError as e:
                validation_errors.append(f"Invalid JSON response: {str(e)}")
                is_valid = False

        # If validation failed, log detailed error context
        if not is_valid:
            response_ctx = create_response_context(response)
            error_ctx = ErrorContext(
                error_type="validation_failed",
                message=" | ".join(validation_errors),
                request=req_ctx,
                response=response_ctx,
                expected_status=valid_status_codes,
                actual_status=response.status_code,
            )
            log_failure(error_ctx)

        return is_valid

    def _validate_json_structure(self, json_data: Any, method: str, endpoint: str) -> bool:
        """Validate JSON response structure"""
        if method == 'GET' and isinstance(json_data, list):
            if json_data and isinstance(json_data[0], dict):
                return 'id' in json_data[0] or len(json_data[0]) > 0
        elif method in ['POST', 'PUT', 'PATCH'] and isinstance(json_data, dict):
            return len(json_data) > 0
        return True

    def add_custom_validation(self, method: str, validation_func):
        """Add custom validation function for specific method"""
        if not hasattr(self, 'custom_validators'):
            self.custom_validators = {}
        self.custom_validators[method] = validation_func


class RequestLogger:
    """Logs HTTP requests for debugging and analysis with enhanced error details"""

    def __init__(self, log_file: str = "requests.log"):
        self.log_file = log_file
        self.requests_logged = 0
        self.file_handler = logging.FileHandler(log_file)
        self.file_handler.setLevel(logging.INFO)
        formatter = logging.Formatter('%(asctime)s - %(levelname)s - %(message)s')
        self.file_handler.setFormatter(formatter)

        self.request_logger = logging.getLogger('request_logger')
        self.request_logger.addHandler(self.file_handler)
        self.request_logger.setLevel(logging.INFO)

        # Store last request for error context
        self._last_request_context: Optional[RequestContext] = None

    def log_request(self, method: str, url: str, path: str, kwargs: Dict) -> RequestContext:
        """Log request and return context for error logging.

        Returns:
            RequestContext that can be used for detailed error logging
        """
        # Create and store request context
        request_ctx = create_request_context(method, path, url, **kwargs)
        self._last_request_context = request_ctx

        # Log basic info at INFO level
        logger.info(f"REQUEST: {method.upper()} {url}")

        # Log details at INFO level (previously DEBUG - now visible by default for debugging)
        if 'params' in kwargs and kwargs['params']:
            logger.info(f"  Query params: {kwargs['params']}")
        if 'json' in kwargs and kwargs['json']:
            body_preview = json.dumps(kwargs['json'], default=str)
            if len(body_preview) > 500:
                body_preview = body_preview[:500] + "..."
            logger.info(f"  JSON body: {body_preview}")
        if 'data' in kwargs and kwargs['data']:
            logger.info(f"  Form data: {kwargs['data']}")
        if 'files' in kwargs and kwargs['files']:
            logger.info(f"  Files: {list(kwargs['files'].keys())}")

        return request_ctx

    def get_last_request_context(self) -> Optional[RequestContext]:
        """Get the last request context for error logging"""
        return self._last_request_context

    def log_response(self, response, method: str, url: str):
        """Log response details"""
        self.requests_logged += 1
        log_entry = {
            'timestamp': datetime.now().isoformat(),
            'method': method.upper(),
            'url': url,
            'status_code': response.status_code,
            'response_time_ms': response.elapsed.total_seconds() * 1000,
            'response_size': len(response.content) if response.content else 0
        }
        self.request_logger.info(json.dumps(log_entry))

        # Log error responses with full details
        if response.status_code >= 400:
            response_ctx = create_response_context(response)
            error_ctx = ErrorContext(
                error_type="http_error",
                message=f"HTTP {response.status_code} error for {method.upper()} {url}",
                request=self._last_request_context,
                response=response_ctx,
                actual_status=response.status_code,
            )
            log_failure(error_ctx)


class PerformanceMonitor:
    """Monitors and reports performance metrics"""

    def __init__(self):
        self.metrics: List[ResponseMetric] = []
        self.start_time = None
        self.end_time = None
        self.request_counts = defaultdict(int)
        self.error_counts = defaultdict(int)

    def test_start(self):
        self.start_time = datetime.now()
        logger.info("Performance monitoring started")

    def test_stop(self):
        self.end_time = datetime.now()
        logger.info("Performance monitoring stopped")

    def record_response(self, response, method: str, endpoint: str):
        metric = ResponseMetric(
            method=method.upper(),
            endpoint=endpoint,
            response_time=response.elapsed.total_seconds() * 1000,
            status_code=response.status_code,
            response_size=len(response.content) if response.content else 0,
            timestamp=datetime.now(),
            success=response.status_code < 400
        )
        if not metric.success:
            metric.error_message = response.text[:200]
        self.metrics.append(metric)
        endpoint_key = f"{method.upper()} {endpoint}"
        self.request_counts[endpoint_key] += 1
        if not metric.success:
            self.error_counts[endpoint_key] += 1

    def on_request_event(self, request_type, name, response_time, response_length, exception, context,
                         request_context: Optional[RequestContext] = None):
        """Handle Locust request event with enhanced error logging"""
        if exception:
            # Determine error type from exception
            exception_name = type(exception).__name__
            if 'ConnectionError' in exception_name or 'Connection' in str(exception):
                error_type = "connection_error"
            elif 'Timeout' in exception_name or 'timeout' in str(exception).lower():
                error_type = "timeout"
            elif 'SSL' in exception_name:
                error_type = "ssl_error"
            else:
                error_type = "request_exception"

            # Create error context with all available information
            error_ctx = ErrorContext(
                error_type=error_type,
                message=f"{request_type} {name} failed: {str(exception)}",
                request=request_context,
                expected_status=None,
                actual_status=0,  # No response received
                exception=exception,
                stack_trace=traceback.format_exc() if sys.exc_info()[0] else None,
            )
            log_failure(error_ctx)

    def get_statistics(self) -> Dict[str, Any]:
        if not self.metrics:
            return {}
        response_times = [m.response_time for m in self.metrics]
        successful_requests = [m for m in self.metrics if m.success]
        stats = {
            'total_requests': len(self.metrics),
            'successful_requests': len(successful_requests),
            'failed_requests': len(self.metrics) - len(successful_requests),
            'error_rate': (len(self.metrics) - len(successful_requests)) / len(self.metrics) * 100,
            'response_times': {
                'min': min(response_times),
                'max': max(response_times),
                'mean': statistics.mean(response_times),
                'median': statistics.median(response_times),
                'p95': self._percentile(response_times, 95),
                'p99': self._percentile(response_times, 99)
            }
        }
        if self.start_time and self.end_time:
            duration = (self.end_time - self.start_time).total_seconds()
            stats['test_duration_seconds'] = duration
            stats['requests_per_second'] = len(self.metrics) / duration
        stats['endpoints'] = self._get_endpoint_stats()
        return stats

    def _percentile(self, data: List[float], percentile: int) -> float:
        sorted_data = sorted(data)
        index = int((percentile / 100) * len(sorted_data))
        return sorted_data[min(index, len(sorted_data) - 1)]

    def _get_endpoint_stats(self) -> Dict[str, Dict]:
        endpoint_stats = {}
        for endpoint_key in self.request_counts.keys():
            endpoint_metrics = [m for m in self.metrics if f"{m.method} {m.endpoint}" == endpoint_key]
            if endpoint_metrics:
                response_times = [m.response_time for m in endpoint_metrics]
                successful = len([m for m in endpoint_metrics if m.success])
                endpoint_stats[endpoint_key] = {
                    'total_requests': len(endpoint_metrics),
                    'successful_requests': successful,
                    'error_rate': (len(endpoint_metrics) - successful) / len(endpoint_metrics) * 100,
                    'avg_response_time': statistics.mean(response_times),
                    'p95_response_time': self._percentile(response_times, 95)
                }
        return endpoint_stats

    def generate_report(self, output_dir: str = "./reports"):
        Path(output_dir).mkdir(exist_ok=True)
        stats = self.get_statistics()

        json_file = Path(output_dir) / f"performance_report_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
        with open(json_file, 'w') as f:
            json.dump(stats, f, indent=2, default=str)

        csv_file = Path(output_dir) / f"performance_metrics_{datetime.now().strftime('%Y%m%d_%H%M%S')}.csv"
        with open(csv_file, 'w', newline='') as f:
            writer = csv.writer(f)
            writer.writerow(['timestamp', 'method', 'endpoint', 'response_time_ms', 'status_code', 'success'])
            for metric in self.metrics:
                writer.writerow([
                    metric.timestamp,
                    metric.method,
                    metric.endpoint,
                    metric.response_time,
                    metric.status_code,
                    metric.success
                ])

        self._generate_summary_report(stats, output_dir)
        logger.info(f"Performance reports generated in {output_dir}")

    def _generate_summary_report(self, stats: Dict, output_dir: str):
        summary_file = Path(output_dir) / f"summary_{datetime.now().strftime('%Y%m%d_%H%M%S')}.txt"
        with open(summary_file, 'w') as f:
            f.write("PERFORMANCE TEST SUMMARY\n")
            f.write("=" * 50 + "\n\n")
            f.write(f"Test Duration: {stats.get('test_duration_seconds', 0):.2f} seconds\n")
            f.write(f"Total Requests: {stats.get('total_requests', 0)}\n")
            f.write(f"Successful Requests: {stats.get('successful_requests', 0)}\n")
            f.write(f"Failed Requests: {stats.get('failed_requests', 0)}\n")
            f.write(f"Error Rate: {stats.get('error_rate', 0):.2f}%\n")
            f.write(f"Requests/Second: {stats.get('requests_per_second', 0):.2f}\n\n")

            response_times = stats.get('response_times', {})
            f.write("RESPONSE TIMES\n")
            f.write("-" * 20 + "\n")
            f.write(f"Min: {response_times.get('min', 0):.2f}ms\n")
            f.write(f"Max: {response_times.get('max', 0):.2f}ms\n")
            f.write(f"Mean: {response_times.get('mean', 0):.2f}ms\n")
            f.write(f"Median: {response_times.get('median', 0):.2f}ms\n")
            f.write(f"95th Percentile: {response_times.get('p95', 0):.2f}ms\n")
            f.write(f"99th Percentile: {response_times.get('p99', 0):.2f}ms\n\n")

            endpoints = stats.get('endpoints', {})
            if endpoints:
                f.write("PER-ENDPOINT STATISTICS\n")
                f.write("-" * 30 + "\n")
                for endpoint, endpoint_stats in endpoints.items():
                    f.write(f"\n{endpoint}:\n")
                    f.write(f"  Requests: {endpoint_stats['total_requests']}\n")
                    f.write(f"  Error Rate: {endpoint_stats['error_rate']:.2f}%\n")
                    f.write(f"  Avg Response Time: {endpoint_stats['avg_response_time']:.2f}ms\n")
                    f.write(f"  95th Percentile: {endpoint_stats['p95_response_time']:.2f}ms\n")


class DataManager:
    """Manages test data and state across users"""

    def __init__(self):
        self.shared_data = {}
        self.user_data = {}

    def store_shared_data(self, key: str, value: Any):
        self.shared_data[key] = value

    def get_shared_data(self, key: str) -> Any:
        return self.shared_data.get(key)

    def store_user_data(self, user_id: str, key: str, value: Any):
        if user_id not in self.user_data:
            self.user_data[user_id] = {}
        self.user_data[user_id][key] = value

    def get_user_data(self, user_id: str, key: str) -> Any:
        return self.user_data.get(user_id, {}).get(key)

    def cleanup_user_data(self, user_id: str):
        if user_id in self.user_data:
            del self.user_data[user_id]


# Global instances
data_manager = DataManager()
