"""Base scenario with shared task logic."""
import logging
from typing import Any, Dict, Optional

from locust import SequentialTaskSet

# Absolute imports - work via sys.path in locustfile.py
{% if auth_enabled %}
from auth.authenticator import Authenticator
{% endif %}
from data import ValidDataGenerator, InvalidDataGenerator, SecurityPayloads

logger = logging.getLogger(__name__)


class BaseScenario(SequentialTaskSet):
    """Base class for all test scenarios with shared utilities."""

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.stored_ids: Dict[str, Any] = {}
        self.valid_data = ValidDataGenerator()
        self.invalid_data = InvalidDataGenerator()
        self.security_data = SecurityPayloads()
{% if auth_enabled %}
        self.authenticator = Authenticator(self.client)
{% endif %}

    def on_start(self):
        """Called when a simulated user starts."""
        super().on_start()
{% if auth_enabled %}
        self.authenticator.login()
{% endif %}

    def on_stop(self):
        """Called when a simulated user stops."""
{% if auth_enabled %}
        self.authenticator.logout()
{% endif %}
        super().on_stop()

    def store_id(self, key: str, value: Any) -> None:
        """Store an ID for use in subsequent requests."""
        self.stored_ids[key] = value
        logger.debug(f"Stored {key}: {value}")

    def get_id(self, key: str) -> Optional[Any]:
        """Retrieve a stored ID."""
        return self.stored_ids.get(key)

    def make_request(
        self,
        method: str,
        path: str,
        data: Optional[Dict] = None,
        expected_status: int = 200,
        name: Optional[str] = None,
    ) -> Optional[Dict]:
        """
        Make an HTTP request with standard error handling.

        Args:
            method: HTTP method (GET, POST, PUT, DELETE, PATCH)
            path: Request path
            data: Request body data
            expected_status: Expected HTTP status code
            name: Request name for Locust stats

        Returns:
            Response JSON if successful, None otherwise
        """
        request_kwargs = {"catch_response": True}
        if name:
            request_kwargs["name"] = name
        if data:
            request_kwargs["json"] = data

        method_func = getattr(self.client, method.lower())

        with method_func(path, **request_kwargs) as response:
            if response.status_code == expected_status:
                response.success()
                try:
                    return response.json()
                except Exception:
                    return None
            else:
                response.failure(
                    f"Expected {expected_status}, got {response.status_code}"
                )
                return None

    def expect_error(
        self,
        method: str,
        path: str,
        data: Optional[Dict] = None,
        expected_statuses: tuple = (400, 422),
        name: Optional[str] = None,
    ) -> bool:
        """
        Make a request expecting an error response.

        Args:
            method: HTTP method
            path: Request path
            data: Request body data
            expected_statuses: Tuple of expected error status codes
            name: Request name for Locust stats

        Returns:
            True if expected error received, False otherwise
        """
        request_kwargs = {"catch_response": True}
        if name:
            request_kwargs["name"] = name
        if data:
            request_kwargs["json"] = data

        method_func = getattr(self.client, method.lower())

        with method_func(path, **request_kwargs) as response:
            if response.status_code in expected_statuses:
                response.success()
                return True
            elif response.status_code == 500:
                response.failure(f"Server error - possible vulnerability")
                return False
            else:
                response.failure(
                    f"Expected {expected_statuses}, got {response.status_code}"
                )
                return False
