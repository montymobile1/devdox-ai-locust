"""Main workflow - composes all test scenarios."""
import logging

from locust import HttpUser, between

from scenarios import (
    PositiveTasks,
    NegativeTasks,
    SecurityTasks,
    EdgeCaseTasks,
)

logger = logging.getLogger(__name__)


class MainWorkflow(HttpUser):
    """
    Main load test workflow composing all scenario types.

    Scenario distribution:
    - Positive scenarios: 60%
    - Negative scenarios: 25%
    - Security scenarios: 10%
    - Edge cases: 5%
    """

    # Wait between tasks (in seconds)
    wait_time = between(1, 3)

    # Host from config
    host = "{{ target_host }}"

    # Task distribution by weight
    tasks = {
        PositiveTasks: 6,    # 60%
        NegativeTasks: 2.5,  # 25%
        SecurityTasks: 1,    # 10%
        EdgeCaseTasks: 0.5,  # 5%
    }

    def on_start(self):
        """Called when a simulated user starts."""
        logger.info(f"User starting - targeting {self.host}")

    def on_stop(self):
        """Called when a simulated user stops."""
        logger.info("User stopping")
