class BaseTaskMethods:
    """Mixin class with common task functionality - no inheritance conflicts"""

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self._initialize_attributes()

    def _initialize_attributes(self):
        """Initialize all required attributes"""
        if not hasattr(self, 'auth_token'):
            self.auth_token = None
        if not hasattr(self, 'user_data'):
            self.user_data = {}
        if not hasattr(self, 'request_count'):
            self.request_count = 0
        if not hasattr(self, 'default_headers'):
            self._setup_authentication()
            self._setup_headers()

    def on_start(self):
        """Initialize user session"""
        self._initialize_attributes()
        logger.info(f"TaskSet {self.__class__.__name__} started")

    def on_stop(self):
        """Cleanup when user stops"""
        if hasattr(self, 'request_count'):
            logger.info(f"TaskSet {self.__class__.__name__} stopped after {self.request_count} requests")
        else:
            logger.info(f"TaskSet {self.__class__.__name__} stopped after {self.request_count} requests")

    def _setup_authentication(self):
        """Setup authentication (override in subclasses if needed)"""
        if not hasattr(self, 'auth_token'):
            self.auth_token = None
        if config.api_key:
            self.auth_token = config.api_key

    def login_and_get_token(self, login_path: str = "/auth/login",
                            credentials: Optional[Dict] = None) -> bool:
        """
        Perform dynamic login and store the authentication token.

        This method should be called in on_start() when the API requires
        dynamic authentication (not just a static API key).

        Args:
            login_path: The login endpoint path (e.g., "/auth/login", "/api/token")
            credentials: Login credentials dict. If None, uses config defaults.
                        Example: {"email": "test@example.com", "password": "secret"}

        Returns:
            bool: True if login succeeded and token was stored, False otherwise
        """
        if credentials is None:
            # Use default test credentials from config
            credentials = {
                "email": getattr(config, 'test_email', 'test@example.com'),
                "password": getattr(config, 'test_password', 'test_password'),
            }

        try:
            with self.client.post(login_path, json=credentials, catch_response=True) as response:
                if response.status_code == 200:
                    response_data = response.json()
                    # Extract token from response (handle various response formats)
                    self.auth_token = (
                        response_data.get("access_token") or
                        response_data.get("token") or
                        response_data.get("data", {}).get("token") or
                        response_data.get("data", {}).get("access_token")
                    )

                    if self.auth_token:
                        # Update headers with new token
                        self.default_headers["Authorization"] = f"Bearer {self.auth_token}"
                        if hasattr(self, 'client') and hasattr(self.client, 'headers'):
                            self.client.headers.update(self.default_headers)
                        response.success()
                        logger.info(f"Login successful - token acquired")
                        return True
                    else:
                        response.failure("Login response missing token field")
                        logger.warning("Login response did not contain expected token field")
                        return False
                else:
                    response.failure(f"Login failed with status {response.status_code}")
                    logger.warning(f"Login failed: {response.status_code}")
                    return False
        except Exception as e:
            logger.error(f"Login exception: {e}")
            return False

    def logout(self, logout_path: str = "/auth/logout") -> bool:
        """
        Perform logout and clear authentication token.

        Call this in on_stop() to properly clean up sessions.

        Args:
            logout_path: The logout endpoint path

        Returns:
            bool: True if logout succeeded, False otherwise
        """
        if not self.auth_token:
            return True  # Nothing to logout

        try:
            with self.client.post(logout_path, catch_response=True) as response:
                if response.status_code in [200, 204]:
                    response.success()
                    logger.info("Logout successful")
                else:
                    # Logout failures are usually not critical
                    response.success()  # Don't fail the test for logout issues
                    logger.debug(f"Logout returned {response.status_code}")

                # Clear token regardless of response
                self.auth_token = None
                if "Authorization" in self.default_headers:
                    del self.default_headers["Authorization"]
                return True
        except Exception as e:
            logger.debug(f"Logout exception (non-critical): {e}")
            self.auth_token = None
            return False

    def handle_401_retry(self, method: str, path: str, **kwargs) -> Optional[Dict]:
        """
        Make a request with automatic re-authentication on 401 Unauthorized.

        If the request returns 401, this method will:
        1. Attempt to re-login using login_and_get_token()
        2. Retry the original request with the new token

        Args:
            method: HTTP method (GET, POST, etc.)
            path: API endpoint path
            **kwargs: Additional arguments passed to make_request

        Returns:
            Response data dict or None (same as make_request)
        """
        # First attempt
        result = self.make_request(method, path, **kwargs)
        if result is not None:
            return result

        # Check if we should retry (only on auth failure)
        # Since make_request returns None on failure, we need to make a raw request to check
        try:
            with self.client.request(method=method, url=path, catch_response=True, **kwargs) as response:
                if response.status_code == 401:
                    logger.info(f"Got 401 on {method} {path}, attempting re-authentication...")
                    # Re-authenticate
                    if self.login_and_get_token():
                        # Retry original request
                        return self.make_request(method, path, **kwargs)
                    else:
                        logger.warning("Re-authentication failed, cannot retry request")
                        response.failure("401 Unauthorized - re-auth failed")
                        return None
                else:
                    # Not a 401, original failure stands
                    return None
        except Exception as e:
            logger.error(f"Error in 401 retry handler: {e}")
            return None

    def _setup_headers(self):
        """Setup default headers for all requests"""
        if not hasattr(self, 'auth_token'):
            self._setup_authentication()
        self.default_headers = {
            "Content-Type": "application/json",
            "Accept": "application/json",
            "User-Agent": "Locust-LoadTest/1.0"
        }
        if self.auth_token:
            self.default_headers["Authorization"] = f"Bearer {self.auth_token}"

    def make_request(self, method: str, path: str,
                      expected_status: Optional[List[int]] = None,
                      **kwargs) -> Optional[Dict]:
        """Make HTTP request with logging, validation, and monitoring.

        IMPORTANT: This method returns JSON data (dict) or None, NOT a response object.
        Do NOT try to access .status_code on the return value.

        Args:
            method: HTTP method (GET, POST, PUT, PATCH, DELETE)
            path: API endpoint path
            expected_status: Optional list of valid HTTP status codes from OpenAPI spec.
                           If provided, these codes are considered valid responses.
                           Example: [201, 422] for a POST that can return 201 (created) or 422 (validation error)
                           If not provided, falls back to method-based defaults.
            **kwargs: Additional arguments passed to the HTTP client (json, data, params, headers, etc.)

        Returns:
            Optional[Dict]: JSON response data as a dictionary, or None if:
                - The response status code is not in expected_status
                - The response is not valid JSON
                - An exception occurred

        Usage:
            # Simple usage (uses method-based default status codes)
            result = self.make_request("GET", "/items")
            if result:
                print(result)  # result is a dict, not a response object

            # With OpenAPI spec-derived expected status codes
            result = self.make_request("POST", "/items", expected_status=[201, 422], json=data)
            if result:
                # Request succeeded and returned valid JSON
                item_id = result.get("id")
        """
        self._initialize_attributes()
        self.request_count += 1

        # Capture request body for error logging
        request_body = kwargs.get("json") or kwargs.get("data")

        try:
            # Merge headers
            request_headers = {**self.default_headers, **kwargs.get("headers", {})}

            # Set content-type for POST/PUT/PATCH
            if method.upper() in ["POST", "PUT", "PATCH"]:
                if "json" in kwargs:
                    request_headers["Content-Type"] = "application/json"
                elif "data" in kwargs and isinstance(kwargs["data"], dict):
                    request_headers["Content-Type"] = "application/x-www-form-urlencoded"

            kwargs["headers"] = request_headers

            # Log request
            RequestLogger.log_request(method, path, kwargs)

            with self.client.request(
                method=method,
                url=path,  # Relative path - Locust uses host from --host CLI or class attribute
                catch_response=True,
                **kwargs
            ) as response:
                # Validate using caller-provided expected_status or method-based defaults
                is_valid = response_validator.validate_response(
                    response, method, path, expected_status=expected_status,
                    request_body=request_body
                )
                performance_monitor.record_response(response, method, path)

                if not is_valid:
                    response.failure(f"Response validation failed for {method} {path} (status: {response.status_code})")
                    return None

                try:
                    return response.json() if response.content else None
                except json.JSONDecodeError:
                    if response.status_code < 400:
                        return {"raw_content": response.text}
                    response.failure(f"Invalid JSON response for {method} {path}")
                    return None

        except Exception as e:
            logger.error(f"Request failed {method} {path}: {e}")
            log_request_failure(request_body=request_body)
            return None

    def _store_response_data(self, method_name: str, data: Dict):
        """Store response data for future requests"""
        if not hasattr(self, 'user_data'):
            self.user_data = {}
        if data:
            self.user_data[method_name] = data

    def _get_stored_data(self, method_name: str, key: str = None):
        """Retrieve stored response data from previous requests"""
        stored_data = self.user_data.get(method_name)
        if stored_data and key:
            return stored_data.get(key)
        return stored_data


class BaseAPIUser(HttpUser):
    """Base class for API users with common functionality"""

    abstract = True
    wait_time = between(0.5, 1.5)
    # Default host from config - can be overridden by --host CLI argument
    host = config.base_url

    def on_start(self):
        """Initialize user session"""
        self.auth_token = None
        self.user_data = {}
        self.request_count = 0

        # Setup authentication if needed
        self._setup_authentication()

        # Initialize session headers
        self._setup_headers()

        logger.info(f"User {self.__class__.__name__} started")

    def on_stop(self):
        """Cleanup when user stops"""
        logger.info(f"User {self.__class__.__name__} stopped after {self.request_count} requests")

    def _setup_authentication(self):
        """Setup authentication (override in subclasses if needed)"""
        if config.api_key:
            self.auth_token = config.api_key

    def _setup_headers(self):
        """Setup default headers for all requests"""
        self.default_headers = {
            "Content-Type": "application/json",
            "Accept": "application/json",
            "User-Agent": "Locust-LoadTest/1.0"
        }
        if self.auth_token:
            self.default_headers["Authorization"] = f"Bearer {self.auth_token}"


class BaseWorkflow(TaskSet, BaseTaskMethods):
    """Base class for LLM-generated workflows - extends TaskSet for proper Locust integration"""

    def on_start(self):
        """Initialize when TaskSet starts"""
        self._initialize_attributes()
        logger.info(f"Workflow {self.__class__.__name__} started")

    def on_stop(self):
        """Cleanup when TaskSet stops"""
        logger.info(f"Workflow {self.__class__.__name__} stopped")
