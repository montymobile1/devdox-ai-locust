    def on_stop(self):
        """Cleanup: delete all created resources"""
        for resource_id in self.created_ids:
            try:
                self.make_request("DELETE", f"/path/{resource_id}")
            except:
                pass  # Best effort cleanup
        self.created_ids.clear()
        {% if auth_endpoints %}
        self.logout()
        {% endif %}
        super().on_stop()

    # === CRUD LIFECYCLE ===

    @task
    def step_1_create_resource(self):
