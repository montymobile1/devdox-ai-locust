4. **CLASS STRUCTURE**:
   ```python
   from base_workflow import BaseWorkflow
   import test_data

   class {{ class_name }}StateWorkflow(BaseWorkflow):
       """State-dependent tests for {{ tag_name }} endpoints"""

       created_resources = []  # Store IDs for state-dependent tests

       def on_start(self):
           super().on_start()
           self.created_resources = []

       def on_stop(self):
           # Clean up created resources
           for resource_id in self.created_resources:
               self.client.delete(f"/path/{resource_id}")
           super().on_stop()

       @task(5)
       def test_create_then_read(self):
           """Test create followed by read"""
           data = test_data.get_valid_data()
           with self.client.post("/path", json=data, catch_response=True) as response:
               if response.status_code == 201:
                   resource_id = response.json().get('id')
                   self.created_resources.append(resource_id)
                   response.success()
                   # Now read it back
                   with self.client.get(f"/path/{resource_id}", catch_response=True) as read_resp:
                       if read_resp.status_code == 200:
                           read_resp.success()
                       else:
                           read_resp.failure(f"Read failed: {read_resp.status_code}")
               else:
                   response.failure(f"Create failed: {response.status_code}")

       @task(3)
       def test_duplicate_create_conflict(self):
           """Test duplicate creation - expect 409"""
           data = test_data.get_valid_data()
           # Create first
           resp1 = self.client.post("/path", json=data)
           if resp1.status_code == 201:
               self.created_resources.append(resp1.json().get('id'))
               # Try duplicate
               with self.client.post("/path", json=data, catch_response=True) as resp2:
                   if resp2.status_code == 409:
                       resp2.success()
                   else:
                       resp2.failure(f"Expected 409, got {resp2.status_code}")
   ```

