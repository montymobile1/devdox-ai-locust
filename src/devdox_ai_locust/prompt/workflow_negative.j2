4. **CLASS STRUCTURE**:
   ```python
   from base_workflow import BaseWorkflow
   import test_data
   import uuid

   class {{ class_name }}NegativeWorkflow(BaseWorkflow):
       """Negative, edge case, and error handling tests for {{ tag_name }} endpoints"""

       @task(3)
       def test_missing_required_field(self):
           """Test request with missing required field - expect 400"""
           data = {"optional_field": "value"}  # Missing required fields
           with self.client.post("/path", json=data, catch_response=True) as response:
               if response.status_code in [400, 422]:
                   response.success()
               else:
                   response.failure(f"Expected 400/422, got {response.status_code}")

       @task(3)
       def test_invalid_id_not_found(self):
           """Test with non-existent ID - expect 404"""
           fake_id = str(uuid.uuid4())
           with self.client.get(f"/path/{fake_id}", catch_response=True) as response:
               if response.status_code == 404:
                   response.success()
               else:
                   response.failure(f"Expected 404, got {response.status_code}")

       @task(2)
       def test_unauthorized_access(self):
           """Test without auth - expect 401"""
           original_headers = dict(self.client.headers)
           self.client.headers.clear()
           with self.client.get("/protected/path", catch_response=True) as response:
               if response.status_code == 401:
                   response.success()
               else:
                   response.failure(f"Expected 401, got {response.status_code}")
           self.client.headers.update(original_headers)
   ```

